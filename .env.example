# Copie ce fichier en .env puis remplis les valeurs.

# Jeton demandé par POST /api/upload et /api/covers/refresh (en-tête x-upload-token).
# Génère-le par exemple avec : openssl rand -hex 16
UPLOAD_TOKEN=

# Taille maximale d'un fichier envoyé, en Mo.
MAX_UPLOAD_MB=512

# uid/gid utilisés par le conteneur pour écrire dans roms/, covers/ et state/.
PUID=1000
PGID=1000

# Serveur netplay EmulatorJS (WebSocket), par exemple wss://netplay.exemple.fr.
# Laisser vide pour désactiver le netplay dans le lecteur.
NETPLAY_SERVER=

# Serveurs ICE supplémentaires, en JSON, pour le netplay derrière un NAT strict.
# Exemple : [{"urls":"stun:stun.exemple.fr:3478"}]
NETPLAY_ICE_SERVERS=
